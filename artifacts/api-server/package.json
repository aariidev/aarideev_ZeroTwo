{
  "name": "@workspace/api-server",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:maps": "node --env-file=../../.env ./build.mjs",
    "start": "node ./dist/index.mjs",
    "start:maps": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.12.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "discord.js": "^14.27.0",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^7.5.1",
    "ffmpeg-static": "^5.3.0",
    "mysql2": "^3.23.0",
    "opusscript": "^0.1.1",
    "pino": "^9",
    "pino-http": "^10",
    "play-dl": "^1.9.7",
    "sodium-native": "^5.1.0",
    "youtube-dl-exec": "^3.1.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.4"
  }
}
